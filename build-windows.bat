@echo off
rem Builds this program on Windows from the command line.
rem
rem Requirements:
rem   - git
rem   - Visual Studio 2022, or the Build Tools for Visual Studio 2022, with the
rem     "Desktop development with C++" workload (MSVC x86/x64 build tools, a
rem     Windows SDK and "C++ CMake tools for Windows"). The IDE is not needed.
rem
rem Usage:
rem   build-windows.bat         build FLTK if it is not built yet, then the program
rem   build-windows.bat fltk    download (if needed) and build only FLTK
rem   build-windows.bat app     build only the program
rem   build-windows.bat test    build FLTK if it is not built yet, then build and run the tests
rem
rem The result is bin\Release\purple-polished-map.exe (32-bit, like the official releases).
rem The tests are bin\Release\purple-polished-map-tests.exe; see tests\README.md.

setlocal

set "FLTK_VERSION=1.4.5"
set "FLTK_ABI_VERSION=10405"

set "ROOT=%~dp0"
if "%ROOT:~-1%"=="\" set "ROOT=%ROOT:~0,-1%"
set "FLTK_SRC=%ROOT%\lib\fltk-%FLTK_VERSION%"
set "FLTK_BUILD=%FLTK_SRC%\build"

set "WHAT=%~1"
if "%WHAT%"=="" set "WHAT=all"
if /i "%WHAT%"=="all" goto find_tools
if /i "%WHAT%"=="fltk" goto find_tools
if /i "%WHAT%"=="app" goto find_tools
if /i "%WHAT%"=="test" goto find_tools
echo Usage: %~nx0 [all^|fltk^|app^|test]
exit /b 2

:find_tools
rem vswhere is run from its own folder so that no path containing parentheses
rem ("Program Files (x86)") has to appear inside the FOR command below.
set "VSINSTALLER=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer"
if not exist "%VSINSTALLER%\vswhere.exe" goto no_tools
set "VSINSTALL="
pushd "%VSINSTALLER%"
for /f "usebackq delims=" %%i in (`.\vswhere.exe -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set "VSINSTALL=%%i"
popd
if not defined VSINSTALL goto no_tools
if not exist "%VSINSTALL%\VC\Auxiliary\Build\vcvarsall.bat" goto no_tools
rem An x86 (32-bit) target built with the 64-bit compiler
call "%VSINSTALL%\VC\Auxiliary\Build\vcvarsall.bat" x64_x86 >nul
if errorlevel 1 goto no_tools
where cmake >nul 2>nul || goto no_cmake
where ninja >nul 2>nul || goto no_cmake

if /i "%WHAT%"=="app" goto app
if /i "%WHAT%"=="fltk" goto fltk
if exist "%ROOT%\lib\fltk_images.lib" if exist "%ROOT%\include\FL\fl_config.h" goto build

:fltk
if exist "%FLTK_SRC%\CMakeLists.txt" goto fltk_configure
echo === Downloading FLTK %FLTK_VERSION% ===
git clone --branch release-%FLTK_VERSION% --depth 1 https://github.com/fltk/fltk.git "%FLTK_SRC%" || goto failed

:fltk_configure
echo === Building FLTK %FLTK_VERSION% (x86, Release) ===
cmake -S "%FLTK_SRC%" -B "%FLTK_BUILD%" -G Ninja ^
	-D CMAKE_BUILD_TYPE=Release ^
	-D FLTK_ABI_VERSION=%FLTK_ABI_VERSION% ^
	-D FLTK_GRAPHICS_GDIPLUS=OFF ^
	-D FLTK_USE_SYSTEM_LIBJPEG=OFF ^
	-D FLTK_USE_SYSTEM_LIBPNG=OFF ^
	-D FLTK_USE_SYSTEM_ZLIB=OFF ^
	-D FLTK_BUILD_TEST=OFF || goto failed
cmake --build "%FLTK_BUILD%" --target fltk_images || goto failed

rem The program expects the libraries in lib\ and the headers in include\FL\,
rem including the fl_config.h generated by this exact configuration.
if not exist "%ROOT%\lib" mkdir "%ROOT%\lib"
copy /y "%FLTK_BUILD%\lib\*.lib" "%ROOT%\lib\" >nul || goto failed
xcopy /e /i /y /q "%FLTK_SRC%\FL" "%ROOT%\include\FL" >nul || goto failed
copy /y "%FLTK_BUILD%\FL\fl_config.h" "%ROOT%\include\FL\" >nul || goto failed
if /i "%WHAT%"=="fltk" goto done

:build
if /i "%WHAT%"=="test" goto test

:app
echo === Building the program (Release, Win32) ===
msbuild "%ROOT%\ide\polished-map.sln" /m /nologo /v:minimal /p:Configuration=Release /p:Platform=Win32 || goto failed
echo.
echo Built: %ROOT%\bin\Release\purple-polished-map.exe

:done
exit /b 0

:test
echo === Building the tests (Release, Win32) ===
msbuild "%ROOT%\ide\polished-map-tests.vcxproj" /m /nologo /v:minimal /p:Configuration=Release /p:Platform=Win32 || goto failed
echo === Running the tests ===
"%ROOT%\bin\Release\purple-polished-map-tests.exe" --root "%ROOT%" || goto tests_failed
exit /b 0

:tests_failed
echo.
echo Some tests failed.
exit /b 1

:no_tools
echo Could not find the Visual Studio C++ build tools.
echo Install Visual Studio 2022 or the Build Tools for Visual Studio 2022
echo with the "Desktop development with C++" workload.
exit /b 1

:no_cmake
echo Could not find cmake and ninja.
echo Add "C++ CMake tools for Windows" in the Visual Studio Installer.
exit /b 1

:failed
echo.
echo Build failed.
exit /b 1
